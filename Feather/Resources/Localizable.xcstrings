    "التطبيق مبني على مشروع Feather مفتوح المصدر، ويُوزَّع بموجب رخصة GNU General Public License الإصدار الثالث (GPL-3.0). والشيفرة المصدرية متاحة في مستودع التطبيق على GitHub.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التطبيق مبني على مشروع Feather مفتوح المصدر، ويُوزَّع بموجب رخصة GNU General Public License الإصدار الثالث (GPL-3.0). والشيفرة المصدرية متاحة في مستودع التطبيق على GitHub."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is based on the open-source Feather project and is distributed under the GNU General Public License version 3 (GPL-3.0). The source code is available in the app’s GitHub repository."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app se basa en el proyecto de código abierto Feather y se distribuye bajo la licencia GNU General Public License versión 3 (GPL-3.0). El código fuente está disponible en el repositorio de GitHub de la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app est basée sur le projet open source Feather et distribuée sous la licence GNU General Public License version 3 (GPL-3.0). Le code source est disponible dans le dépôt GitHub de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение основано на проекте с открытым исходным кодом Feather и распространяется по лицензии GNU General Public License версии 3 (GPL-3.0). Исходный код доступен в репозитории приложения на GitHub."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama açık kaynaklı Feather projesine dayanır ve GNU General Public License sürüm 3 (GPL-3.0) kapsamında dağıtılır. Kaynak kodu uygulamanın GitHub deposunda mevcuttur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ایپ اوپن سورس پروجیکٹ Feather پر مبنی ہے اور GNU General Public License ورژن 3 (GPL-3.0) کے تحت تقسیم کی جاتی ہے۔ سورس کوڈ ایپ کی GitHub ریپوزٹری میں دستیاب ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用基于开源项目 Feather，并依据 GNU 通用公共许可证第 3 版（GPL-3.0）分发。源代码可在应用的 GitHub 仓库中获取。"
          }
        }
      }
    },
