    "تُضاف المصادر من زر المصادر في الأعلى.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُضاف المصادر من زر المصادر في الأعلى."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add sources with the Sources button at the top."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade fuentes con el botón Fuentes de arriba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des sources avec le bouton Sources en haut."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источники добавляются кнопкой «Источники» вверху."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynaklar üstteki Kaynaklar düğmesinden eklenir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اوپر سورسز کے بٹن سے سورسز شامل کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用顶部的“源”按钮添加源。"
          }
        }
      }
    },
    "تُطبَّق الخيارات الافتراضية (الاسم، معرّف الحزمة، الإصدار، الأدوات المحقونة، مشاركة الملفات، إزالة URL Schemes، إزالة تطبيق الساعة، الحد الأدنى لإصدار iOS، الصلاحيات المخصصة، وغيرها) تلقائيًا على كل تثبيت وتحديث. طريقة التثبيت الافتراضية «Semi Local» مناسبة لإصدارات iOS الحديثة.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق الخيارات الافتراضية (الاسم، معرّف الحزمة، الإصدار، الأدوات المحقونة، مشاركة الملفات، إزالة URL Schemes، إزالة تطبيق الساعة، الحد الأدنى لإصدار iOS، الصلاحيات المخصصة، وغيرها) تلقائيًا على كل تثبيت وتحديث. طريقة التثبيت الافتراضية «Semi Local» مناسبة لإصدارات iOS الحديثة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default options (name, bundle ID, version, injected tweaks, file sharing, URL scheme removal, Watch app removal, minimum iOS version, custom entitlements, and more) are applied automatically to every install and update. The default “Semi Local” method suits recent iOS versions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las opciones predeterminadas (nombre, ID de paquete, versión, tweaks inyectados, compartir archivos, eliminar URL Schemes, eliminar la app del Watch, versión mínima de iOS, permisos personalizados y más) se aplican automáticamente en cada instalación y actualización. El método predeterminado «Semi Local» es adecuado para versiones recientes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les options par défaut (nom, identifiant de bundle, version, tweaks injectés, partage de fichiers, suppression des URL Schemes, suppression de l’app Watch, version iOS minimale, autorisations personnalisées, etc.) s’appliquent automatiquement à chaque installation et mise à jour. La méthode par défaut « Semi Local » convient aux versions récentes d’iOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметры по умолчанию (имя, идентификатор пакета, версия, внедрённые твики, общий доступ к файлам, удаление URL Schemes, удаление приложения для Watch, минимальная версия iOS, собственные права и др.) применяются автоматически к каждой установке и обновлению. Способ «Semi Local» по умолчанию подходит для новых версий iOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan seçenekler (ad, paket kimliği, sürüm, eklenen tweak’ler, dosya paylaşımı, URL Scheme kaldırma, Watch uygulamasını kaldırma, en düşük iOS sürümü, özel yetkiler vb.) her yükleme ve güncellemede otomatik uygulanır. Varsayılan “Semi Local” yöntemi yeni iOS sürümlerine uygundur."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ڈیفالٹ آپشنز (نام، بنڈل آئی ڈی، ورژن، شامل کردہ ٹویکس، فائل شیئرنگ، URL Schemes ہٹانا، واچ ایپ ہٹانا، کم از کم iOS ورژن، حسب ضرورت اجازتیں وغیرہ) ہر انسٹال اور اپ ڈیٹ پر خودکار لاگو ہوتے ہیں۔ ڈیفالٹ «Semi Local» طریقہ نئے iOS ورژنز کے لیے موزوں ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默认选项（名称、Bundle ID、版本、注入的插件、文件共享、移除 URL Schemes、移除 Watch 应用、最低 iOS 版本、自定义权限等）会自动应用于每次安装和更新。默认的“Semi Local”方式适用于较新的 iOS 版本。"
          }
        }
      }
    },
    "تُطبَّق اللغة الجديدة بعد إعادة فتح التطبيق.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبَّق اللغة الجديدة بعد إعادة فتح التطبيق."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The new language applies after reopening the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo idioma se aplica al volver a abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle langue s’applique après la réouverture de l’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Новый язык применится после повторного открытия приложения."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni dil, uygulama yeniden açıldığında uygulanır."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نئی زبان ایپ دوبارہ کھولنے کے بعد لاگو ہوگی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新打开应用后将使用新语言。"
          }
        }
      }
    },
    "ثبّت أي تطبيق بضغطة واحدة، وتصلك تحديثاته تلقائيًا.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت أي تطبيق بضغطة واحدة، وتصلك تحديثاته تلقائيًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install any app with one tap and get its updates automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala cualquier app con un toque y recibe sus actualizaciones automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez n’importe quelle app en un geste et recevez ses mises à jour automatiquement."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливайте любое приложение одним касанием и получайте обновления автоматически."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir uygulamayı tek dokunuşla yükleyin, güncellemeleri otomatik gelsin."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوئی بھی ایپ ایک ٹیپ سے انسٹال کریں اور اس کی اپ ڈیٹس خودکار پائیں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一键安装任何应用，并自动获取更新。"
          }
