    "تعذّر بدء التثبيت بالطريقتين. يمكن تغيير طريقة التثبيت من الإعدادات.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر بدء التثبيت بالطريقتين. يمكن تغيير طريقة التثبيت من الإعدادات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t start the install with either method. You can change the install method in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la instalación con ningún método. Puedes cambiar el método en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lancer l’installation avec les deux méthodes. La méthode peut être changée dans Réglages."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось начать установку ни одним способом. Способ установки можно изменить в настройках."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yükleme iki yöntemle de başlatılamadı. Yükleme yöntemi Ayarlar’dan değiştirilebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دونوں طریقوں سے انسٹال شروع نہ ہو سکا۔ انسٹال کا طریقہ سیٹنگز میں بدلا جا سکتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两种方式都无法开始安装。可在设置中更改安装方式。"
          }
        }
      }
    },
