    "Toggling show sheet will present a share sheet after exporting to your files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عند تفعيل خيار إظهار النافذة، ستظهر نافذة المشاركة بعد التصدير إلى ملفاتك."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapnutí sdílícího panelu ho ukáže po exportu do Souborů."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, erscheint nach dem Export in deine Dateien ein Teilen-Dialog."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggling show sheet will present a share sheet after exporting to your files."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan tampilan lembar akan menampilkan lembar berbagi setelah mengekspor ke berkas Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Abilitando questa opzione mosta una schermata di condivisione dopo aver esportato i file."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트 표시를 토글하면 파일에 내보낸 후 공유 시트가 표시됩니다."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączenie arkusza spowoduje wyświetlenie arkusza udostępniania po wyeksportowaniu do plików."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paylaşım sayfasını göster seçeneğinin etkinleştirilmesi, dışa aktarım sonrasında bir paylaşım sayfasının görüntülenmesini sağlayacaktır."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật tính năng này sẽ hiển thị một bảng chia sẻ sau khi xuất IPA vào tệp của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启用该选项会在导出文件时显示共享菜单。"
          }
        }
      }
    },
