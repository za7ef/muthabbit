    "حُذفت ملفات هذا التطبيق بعد تثبيته. يمكن تثبيته مجددًا من «المتجر».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حُذفت ملفات هذا التطبيق بعد تثبيته. يمكن تثبيته مجددًا من «المتجر»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app’s files were deleted after it was installed. It can be reinstalled from “Store”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de esta app se eliminaron tras instalarla. Puede reinstalarse desde «Tienda»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de cette app ont été supprimés après l’installation. Elle peut être réinstallée depuis « Store »."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы этого приложения удалены после установки. Его можно установить снова из «Магазина»."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın dosyaları yüklendikten sonra silindi. “Mağaza”dan yeniden yüklenebilir."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ایپ کی فائلیں انسٹال کے بعد حذف ہو گئیں۔ اسے «اسٹور» سے دوبارہ انسٹال کیا جا سکتا ہے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此应用的文件在安装后已删除。可从“商店”重新安装。"
          }
        }
      }
    },
