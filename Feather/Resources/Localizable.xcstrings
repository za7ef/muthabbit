    "لا يجمع التطبيق أي بيانات شخصية، ولا يحتوي على حسابات أو إعلانات أو أدوات تتبّع أو تحليلات، ولا يرسل أي معلومات عن المستخدم إلى المطوّر.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع التطبيق أي بيانات شخصية، ولا يحتوي على حسابات أو إعلانات أو أدوات تتبّع أو تحليلات، ولا يرسل أي معلومات عن المستخدم إلى المطوّر."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app collects no personal data, has no accounts, ads, trackers, or analytics, and sends no information about the user to the developer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no recopila datos personales, no tiene cuentas, anuncios, rastreadores ni analíticas, y no envía información del usuario al desarrollador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne collecte aucune donnée personnelle, ne contient ni comptes, ni publicités, ni traceurs, ni analyses, et n’envoie aucune information sur l’utilisateur au développeur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не собирает персональные данные, не содержит аккаунтов, рекламы, трекеров и аналитики и не отправляет разработчику никакой информации о пользователе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama hiçbir kişisel veri toplamaz; hesap, reklam, izleyici veya analiz içermez ve kullanıcı hakkında geliştiriciye bilgi göndermez."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ کوئی ذاتی ڈیٹا جمع نہیں کرتی، اس میں اکاؤنٹس، اشتہارات، ٹریکرز یا اینالیٹکس نہیں، اور یہ صارف کی کوئی معلومات ڈیولپر کو نہیں بھیجتی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不收集任何个人数据，不含账户、广告、追踪器或分析工具，也不会向开发者发送任何用户信息。"
          }
        }
      }
    },
    "لا يستهدف التطبيق الأطفال، ولا يجمع أي بيانات عن أي فئة عمرية.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستهدف التطبيق الأطفال، ولا يجمع أي بيانات عن أي فئة عمرية."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not aimed at children and collects no data about any age group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app no está dirigida a niños y no recopila datos de ningún grupo de edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app ne s’adresse pas aux enfants et ne collecte aucune donnée sur aucune tranche d’âge."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение не предназначено для детей и не собирает данные ни о какой возрастной группе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama çocuklara yönelik değildir ve hiçbir yaş grubu hakkında veri toplamaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایپ بچوں کے لیے نہیں ہے اور کسی بھی عمر کے گروپ کا ڈیٹا جمع نہیں کرتی۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用不面向儿童，也不收集任何年龄段的数据。"
          }
        }
      }
    },
    "لاحقًا": {
