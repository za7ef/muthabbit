    "انتهت صلاحية الرمز. يلزم البدء من جديد.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية الرمز. يلزم البدء من جديد."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The code expired. Please start again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El código caducó. Empieza de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le code a expiré. Veuillez recommencer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия кода истёк. Начните заново."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kodun süresi doldu. Lütfen yeniden başlayın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کوڈ کی میعاد ختم ہو گئی۔ دوبارہ شروع کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代码已过期，请重新开始。"
          }
        }
      }
    },
    "انتهت صلاحية تسجيل الدخول. يلزم تسجيل الدخول مجددًا.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية تسجيل الدخول. يلزم تسجيل الدخول مجددًا."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sign-in expired. Please sign in again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión caducó. Inicia sesión de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion a expiré. Veuillez vous reconnecter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок входа истёк. Войдите снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturumun süresi doldu. Lütfen yeniden oturum açın."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سائن ان کی میعاد ختم ہو گئی۔ دوبارہ سائن ان کریں۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录已过期，请重新登录。"
          }
        }
      }
    },
    "تبقى ملفات الشهادة وكلمة المرور داخل مساحة التطبيق على الجهاز، وتُستخدم فقط لتوقيع التطبيقات محليًا. ولا تُشارك مع أي جهة إلا إذا اختار المستخدم تصديرها بنفسه.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى ملفات الشهادة وكلمة المرور داخل مساحة التطبيق على الجهاز، وتُستخدم فقط لتوقيع التطبيقات محليًا. ولا تُشارك مع أي جهة إلا إذا اختار المستخدم تصديرها بنفسه."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Certificate files and passwords stay inside the app’s storage on the device and are used only to sign apps locally. They are not shared with anyone unless the user chooses to export them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos de certificado y las contraseñas permanecen en el almacenamiento de la app en el dispositivo y solo se usan para firmar apps localmente. No se comparten con nadie salvo que el usuario decida exportarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers de certificat et mots de passe restent dans l’espace de l’app sur l’appareil et servent uniquement à signer des apps localement. Ils ne sont partagés avec personne, sauf si l’utilisateur choisit de les exporter."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы сертификатов и пароли хранятся в пространстве приложения на устройстве и используются только для локальной подписи. Они никому не передаются, если пользователь сам не решит их экспортировать."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertifika dosyaları ve parolalar cihazdaki uygulama alanında kalır ve yalnızca uygulamaları yerel olarak imzalamak için kullanılır. Kullanıcı kendisi dışa aktarmadıkça kimseyle paylaşılmaz."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سرٹیفکیٹ فائلیں اور پاس ورڈ ڈیوائس پر ایپ کی جگہ میں رہتے ہیں اور صرف مقامی طور پر ایپس سائن کرنے کے لیے استعمال ہوتے ہیں۔ صارف خود ایکسپورٹ نہ کرے تو کسی سے شیئر نہیں ہوتے۔"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "证书文件和密码保存在设备上的应用空间内，仅用于在本地签名应用。除非用户自行选择导出，否则不会与任何人共享。"
          }
        }
      }
    },
