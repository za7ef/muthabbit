    "Open an [issue](https://github.com/claration/Feather/issues) on GitHub if you want your source to be featured.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإبراز مصدرك، يمكن فتح طلب في GitHub."
          }
        }
      }
    },
    "Open an [issue](https://github.com/khcrysalis/Feather/issues) on GitHub if you want your source to be featured.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح [issues](https://github.com/khcrysalis/Feather/issues) على GitHub إذا كنت تريد أن يتم تمييز مصدرك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle ein [Issue](https://github.com/khcrysalis/Feather/issues) auf GitHub wenn du deine Quelle aufgelistet haben möchtest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open an [issue](https://github.com/khcrysalis/Feather/issues) on GitHub if you want your source to be featured."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un [problema](https://github.com/khcrysalis/Feather/issues) su GitHub se vuoi che la tua fonte sia consigliata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소스가 소개되기를 원하신다면 GitHub에서 [이슈](https://github.com/khcrysalis/Feather/issues)를 등록해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz [issue](https://github.com/khcrysalis/Feather/issues) na GitHubie, jeśli chcesz, aby Twoje źródło zostało wyróżnione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynağınızın öne çıkarılmasını istiyorsanız GitHub’da bir [sorun kaydı](https://github.com/khcrysalis/Feather/issues) açın."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở [issue](https://github.com/khcrysalis/Feather/issues) trên GitHub nếu bạn muốn nguồn của mình được giới thiệu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开启一个[issue](https://github.com/khcrysalis/Feather/issues)"
          }
        }
      }
    },
