    "لعرض مستودعاتك وتثبيت تطبيقاتها من «مشاريعي».": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لعرض مستودعاتك وتثبيت تطبيقاتها من «مشاريعي»."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To show your repositories and install their apps from “My Projects”."
          }
        },
        "es": {
