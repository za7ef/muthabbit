          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los comentarios y reportes se reciben en la página de GitHub del desarrollador:\ngithub.com/za7ef"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
