            "state": "translated",
            "value": "Para mostrar tus repositorios e instalar sus apps desde «Mis proyectos»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour afficher vos dépôts et installer leurs apps depuis « Mes projets »."
          }
