    "تظهر هنا التطبيقات التي وُقّعت ولم يكتمل تثبيتها.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر هنا التطبيقات التي وُقّعت ولم يكتمل تثبيتها."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps that were signed but not installed appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí aparecen las apps firmadas cuya instalación no se completó."
          }
        },
        "fr": {
          "stringUnit": {
